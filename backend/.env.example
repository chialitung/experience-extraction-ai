# Database
DATABASE_URL=postgresql://user:password@localhost:5432/experience_extraction
REDIS_URL=redis://localhost:6379/0

# LLM (choose one or configure multiple)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Default LLM provider (openai / anthropic)
DEFAULT_LLM_PROVIDER=openai

# Application
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Baidu Speech Recognition (Realtime ASR requires APP_ID + API_KEY)
BAIDU_SPEECH_APP_ID=your-app-id
BAIDU_SPEECH_API_KEY=your-api-key
BAIDU_SPEECH_SECRET_KEY=your-secret-key

# ============================================================
# Email (SMTP) - 用于密码找回邮件发送
# ============================================================
# 任意支持 SMTP 的邮件服务商均可，按下方对应预设填写即可。
# 注意：多数服务商不接受邮箱登录密码，需在邮箱后台开启 SMTP 并申请「授权码 / App 专用密码」。
#
# ---- 预设：QQ 邮箱 ----
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_SSL=true
#   开启 SMTP 后申请 16 位授权码（QQ邮箱 → 设置 → 账户）
#
# ---- 预设：163 / 网易邮箱 ----
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_SSL=true
#   后台开启 SMTP 服务并申请客户端授权密码
#
# ---- 预设：Gmail ----
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SSL=false           # 587 端口走 STARTTLS，须设为 false
#   需开启两步验证后申请「应用专用密码」
#
# ---- 预设：Outlook / Hotmail ----
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SSL=false           # 同样走 STARTTLS
#
# ---- 预设：自建 / 企业 SMTP ----
#   按运维提供的 host/port 填写；若端口为 465 设 SMTP_SSL=true，587 设 false。
#
# 修改下方 5 个变量为你实际使用的服务商即可：
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=your-email@example.com
SMTP_FROM_EMAIL=your-email@example.com
SMTP_PASSWORD=your-smtp-auth-code-or-app-password
FRONTEND_BASE_URL=http://localhost:5173

# Environment
ENVIRONMENT=development
DEBUG=true
