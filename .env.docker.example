# ============================================================
# Docker Compose 环境变量模板
# 复制为 .env 后填入真实值： cp .env.docker.example .env
# ============================================================

# ---------------------------------------------------
# 必填项（无默认值，必须填写）
# ---------------------------------------------------

# PostgreSQL 数据库密码
POSTGRES_PASSWORD=your-strong-postgres-password

# JWT 密钥（生产环境必须设置强密钥）
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32

# 至少配置一个 LLM 提供商
OPENAI_API_KEY=sk-your-openai-key
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# ---------------------------------------------------
# 可选项（留空则对应功能降级或不启用）
# ---------------------------------------------------

# Anthropic（可选的第二 LLM 提供商）
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# DeepSeek（如未在上面启用）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 百度语音识别（可选，用于语音输入）
# BAIDU_SPEECH_APP_ID=your-app-id
# BAIDU_SPEECH_API_KEY=your-api-key
# BAIDU_SPEECH_SECRET_KEY=your-secret-key

# SMTP 邮件（可选，用于密码找回）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_USERNAME=your-email@example.com
# SMTP_FROM_EMAIL=your-email@example.com
# SMTP_PASSWORD=your-smtp-auth-code

# 前端暴露端口（默认 8080）
FRONTEND_PORT=8080

# 默认 LLM 提供商（openai / anthropic / deepseek）
DEFAULT_LLM_PROVIDER=openai
